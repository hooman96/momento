# Copy to `.env` in this same folder. The storage API loads only this file.
#
# Which backend the factory returns by default. One of: local | s3 | gcs | azure
STORAGE_PROVIDER=local

# HTTP `/objects/...` is unified-only: only clouds below (when env vars are set) — not local disk.

# --- Local (dev) ---
# Absolute or relative path for the filesystem backend.
# Defaults to Backend/storage_interface/.data
# STORAGE_LOCAL_ROOT=./.data

# --- AWS S3 ---
AWS_S3_BUCKET=
AWS_REGION=us-east-1
# Optional: only set when not using a shared credentials file / IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- GCP GCS ---
GCP_GCS_BUCKET=
GCP_PROJECT=
# Path to a service-account JSON. Leave empty to use Application Default
# Credentials (gcloud auth application-default login).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Azure Blob ---
AZURE_BLOB_CONTAINER=
AZURE_STORAGE_CONNECTION_STRING=
